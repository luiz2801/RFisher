{
  "name": "tabuleiro-do-ceo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Jogo de tabuleiro digital e educativo de estatística (hot-seat, sem backend).",
  "scripts": {
    "start": "node scripts/server.mjs",
    "test": "node --test tests/*.test.js",
    "test:cobertura": "mkdir -p coverage && node --test --experimental-test-coverage --test-reporter=spec --test-reporter-destination=stdout --test-reporter=lcov --test-reporter-destination=coverage/lcov.info tests/*.test.js",
    "lint": "node scripts/lint.mjs"
  }
}
